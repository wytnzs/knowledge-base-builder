+# -*- coding: utf-8 -*-
+"""朋友圈（SNS）读取：解析 sns.db 的 SnsTimeLine。
+
+只读：数据库由 DBCache 解密到临时文件，本模块只查询，不写回原库。
+解析逻辑参考 MIT 许可的 chatlog-plus/moments.py，按其 original notice 保留署名。
+"""
+from __future__ import annotations
+
+import sqlite3
+import xml.etree.ElementTree as ET
+from dataclasses import dataclass, field
+from datetime import datetime
+from typing import Any
+
+
+@dataclass
+class Moment:
+    id: str
+    username: str
+    created: datetime
+    text: str
+    media: list[dict[str, str]] = field(default_factory=list)
+
+    def to_dict(self, author: str = "") -> dict[str, Any]:
+        return {
+            "id": self.id,
+            "author": author or self.username,
+            "username": self.username,
+            "text": self.text,
+            "timestamp": int(self.created.timestamp()),
+            "time": self.created.strftime("%Y-%m-%d %H:%M:%S"),
+            "media": self.media,
+            "media_count": len(self.media),
+        }
+
+
+def _text_of(node: ET.Element | None) -> str:
+    if node is None:
+        return ""
+    return "".join(node.itertext()).strip()
+
+
+def parse_moment(content: str) -> Moment | None:
+    try:
+        root = ET.fromstring(content)
+    except ET.ParseError:
+        return None
+    timeline = root.find(".//TimelineObject")
+    if timeline is None:
+        return None
+    moment_id = (timeline.findtext("id") or "").strip()
+    username = (timeline.findtext("username") or "").strip()
+    try:
+        epoch = int((timeline.findtext("createTime") or "0").strip())
+    except ValueError:
+        epoch = 0
+    if not moment_id or epoch <= 0:
+        return None
+    text = (timeline.findtext("contentDesc") or "").strip()
+    if not text:
+        content_object = timeline.find(".//ContentObject")
+        if content_object is not None:
+            text = _text_of(content_object.find("title")) or _text_of(content_object.find("description"))
+    media: list[dict[str, str]] = []
+    for item in timeline.findall(".//mediaList/media"):
+        url = (item.findtext("url") or "").strip()
+        thumb = ""
+        thumb_node = item.find("thumb")
+        if thumb_node is not None:
+            thumb = (thumb_node.text or "").strip()
+        if url or thumb:
+            media.append({
+                "type": (item.findtext("type") or "").strip(),
+                "url": url,
+                "thumb": thumb,
+            })
+    return Moment(
+        id=moment_id,
+        username=username,
+        created=datetime.fromtimestamp(epoch),
+        text=text,
+        media=media,
+    )
+
+
+def read_moments(
+    db_path: str,
+    *,
+    self_wxid: str = "",
+    self_only: bool = False,
+    since_ts: int | None = None,
+    until_ts: int | None = None,
+) -> tuple[list[Moment], dict[str, int]]:
+    stats = {"rows": 0, "parsed": 0, "failed": 0, "dup": 0, "filtered": 0}
+    result: list[Moment] = []
+    seen: set[str] = set()
+    connection = sqlite3.connect(f"file:{db_path}?mode=ro", uri=True)
+    try:
+        rows = connection.execute("select user_name, content from SnsTimeLine").fetchall()
+        stats["rows"] = len(rows)
+        for _username, content in rows:
+            if isinstance(content, bytes):
+                try:
+                    content = content.decode("utf-8", errors="ignore")
+                except Exception:
+                    stats["failed"] += 1
+                    continue
+            if not isinstance(content, str):
+                stats["failed"] += 1
+                continue
+            moment = parse_moment(content)
+            if moment is None:
+                stats["failed"] += 1
+                continue
+            stats["parsed"] += 1
+            if moment.id in seen:
+                stats["dup"] += 1
+                continue
+            seen.add(moment.id)
+            if self_only and self_wxid and moment.username != self_wxid:
+                stats["filtered"] += 1
+                continue
+            ts = int(moment.created.timestamp())
+            if since_ts is not None and ts < since_ts:
+                stats["filtered"] += 1
+                continue
+            if until_ts is not None and ts > until_ts:
+                stats["filtered"] += 1
+                continue
+            result.append(moment)
+    finally:
+        connection.close()
+    result.sort(key=lambda item: item.created, reverse=True)
+    return result, stats
+
+
+def filter_by_user(moments: list[Moment], names: dict[str, str], query: str) -> list[Moment]:
+    q = (query or "").strip().lower()
+    if not q:
+        return moments
+    return [
+        m for m in moments
+        if q in (names.get(m.username, "") or "").lower()
+        or q in (m.username or "").lower()
+        or q in (names.get(m.username, m.username) or "").lower()
+    ]
+
+
+def search_moments(moments: list[Moment], keyword: str) -> list[Moment]:
+    q = (keyword or "").strip().lower()
+    if not q:
+        return []
+    return [m for m in moments if q in (m.text or "").lower()]
