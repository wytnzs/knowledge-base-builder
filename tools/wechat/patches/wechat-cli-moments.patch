+# -*- coding: utf-8 -*-
+"""moments 命令 — 读取本地微信朋友圈（sns.db）"""
+import json
+import os
+
+import click
+
+from ..core.contacts import get_contact_names, get_self_username
+from ..core.messages import parse_time_range
+from ..core.sns import filter_by_user, read_moments, search_moments
+from ..output.formatter import output
+
+
+def _load_moments(ctx, since, until, self_only):
+    app = ctx.obj
+    path = app.cache.get(os.path.join("sns", "sns.db"))
+    if not path:
+        raise click.ClickException(
+            "无法解密 sns/sns.db：本机没有这个库的密钥，或数据库不存在。"
+            "请先确认微信已登录，再运行 wechat-cli init。"
+        )
+    since_ts, until_ts = parse_time_range(since or "", until or "")
+    self_wxid = get_self_username(app.db_dir, app.cache, app.decrypted_dir)
+    names = get_contact_names(app.cache, app.decrypted_dir)
+    moments, stats = read_moments(
+        path,
+        self_wxid=self_wxid,
+        self_only=self_only,
+        since_ts=since_ts,
+        until_ts=until_ts,
+    )
+    return moments, names, stats
+
+
+def _emit(data, fmt, out):
+    if out:
+        with open(out, "w", encoding="utf-8") as f:
+            json.dump(data, f, ensure_ascii=False, indent=2)
+            f.write("\n")
+        output({"ok": True, "path": out, "count": data.get("meta", {}).get("count", 0)}, "json")
+        return
+    output(data, fmt)
+
+
+@click.group("moments")
+def moments():
+    """读取本地微信朋友圈（只读）"""
+
+
+@moments.command("feed")
+@click.option("--user", default="", help="按作者显示名或 wxid 过滤")
+@click.option("--since", default="", help="起始日期 YYYY-MM-DD")
+@click.option("--until", default="", help="结束日期 YYYY-MM-DD")
+@click.option("--limit", default=20, type=int, help="返回条数")
+@click.option("--self-only", is_flag=True, help="只看自己发的")
+@click.option("--format", "fmt", default="json", type=click.Choice(["json", "text"]), help="输出格式")
+@click.option("--out", default="", help="写入 JSON 文件（本地）")
+@click.pass_context
+def feed(ctx, user, since, until, limit, self_only, fmt, out):
+    """按时间线读取朋友圈
+
+    \b
+    示例:
+      wechat-cli moments feed
+      wechat-cli moments feed --user "张三" --limit 50
+      wechat-cli moments feed --since 2026-04-01 --until 2026-04-30
+      wechat-cli moments feed --self-only --format text
+    """
+    items, names, stats = _load_moments(ctx, since, until, self_only)
+    items = filter_by_user(items, names, user)
+    items = items[:max(0, limit)]
+    rows = [m.to_dict(names.get(m.username, m.username)) for m in items]
+    data = {"moments": rows, "meta": {"count": len(rows), **stats}}
+    if fmt == "text" and not out:
+        lines = []
+        for r in rows:
+            line = f"[{r['time']}] {r['author']}: {r['text']}"
+            if r["media_count"]:
+                line += f"  [{r['media_count']} 个媒体]"
+            lines.append(line)
+        output("\n\n".join(lines) if lines else "没有匹配的朋友圈", "text")
+        return
+    _emit(data, fmt, out)
+
+
+@moments.command("search")
+@click.argument("keyword")
+@click.option("--user", default="", help="限定作者")
+@click.option("--since", default="", help="起始日期 YYYY-MM-DD")
+@click.option("--until", default="", help="结束日期 YYYY-MM-DD")
+@click.option("--limit", default=20, type=int, help="返回条数")
+@click.option("--self-only", is_flag=True, help="只搜自己发的")
+@click.option("--format", "fmt", default="json", type=click.Choice(["json", "text"]), help="输出格式")
+@click.option("--out", default="", help="写入 JSON 文件（本地）")
+@click.pass_context
+def search(ctx, keyword, user, since, until, limit, self_only, fmt, out):
+    """搜索朋友圈正文
+
+    \b
+    示例:
+      wechat-cli moments search "保险"
+      wechat-cli moments search "婚礼" --user "李四" --since 2025-01-01
+    """
+    items, names, stats = _load_moments(ctx, since, until, self_only)
+    items = filter_by_user(items, names, user)
+    items = search_moments(items, keyword)
+    items = items[:max(0, limit)]
+    rows = [m.to_dict(names.get(m.username, m.username)) for m in items]
+    data = {"moments": rows, "meta": {"count": len(rows), "keyword": keyword, **stats}}
+    if fmt == "text" and not out:
+        lines = []
+        for r in rows:
+            line = f"[{r['time']}] {r['author']}: {r['text']}"
+            if r["media_count"]:
+                line += f"  [{r['media_count']} 个媒体]"
+            lines.append(line)
+        output("\n\n".join(lines) if lines else "没有匹配的朋友圈", "text")
+        return
+    _emit(data, fmt, out)
